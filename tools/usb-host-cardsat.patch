+// CardSat: root-port reset timings, overridable at sketch build time.
+//
+// These come from the core's sdkconfig.h (30 ms each) and so cannot be raised with a
+// plain -D without a redefinition clash; hence the indirection.
+//
+// Why raise them: with the hub already attached and powered at boot, the root port
+// reset SUCCEEDS immediately and the very first control IN then fails four times in a
+// row with USB_TRANSFER_STATUS_ERROR. With power applied after the host is up, the
+// same hub logs eleven "Root port reset failed" first, then resets cleanly and
+// enumerates perfectly. A deterministic failure straight after a successful reset is
+// the classic signature of too little reset hold or recovery time for that device -
+// USB 2.0 requires only 10 ms, but says nothing about what a given device needs.
+#ifndef CARDSAT_USB_RESET_HOLD_MS
+#define CARDSAT_USB_RESET_HOLD_MS               CONFIG_USB_HOST_RESET_HOLD_MS
+#endif
+#ifndef CARDSAT_USB_RESET_RECOVERY_MS
+#define CARDSAT_USB_RESET_RECOVERY_MS           CONFIG_USB_HOST_RESET_RECOVERY_MS
+#endif
+#define RESET_HOLD_MS                           CARDSAT_USB_RESET_HOLD_MS
+#define RESET_RECOVERY_MS                       CARDSAT_USB_RESET_RECOVERY_MS
 #define RESUME_HOLD_MS                          30  // Spec requires at least 20ms, Make it 30ms to be safe
