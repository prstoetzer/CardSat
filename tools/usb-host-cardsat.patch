+// CardSat: retry a failed enumeration stage before giving up on the device.
+//
+// IDF abandons a device the first time a control transfer fails. Bench evidence: an
+// FT232R that enumerates perfectly on the root port dies behind a powered hub with
+// "Bad transfer status 1: CHECK_SHORT_DEV_DESC" - status 1 is USB_TRANSFER_STATUS_ERROR,
+// a bus-level failure on the very first control IN, not a device refusal. Desktop
+// stacks re-issue that request several times before declaring a device dead, precisely
+// because first-transfer errors behind a hub are often transient.
+//
+// Each CHECK_* stage is preceded by its own GET_* stage (the enum values are ordered),
+// so stepping back one stage re-issues the request. Set to 0 for stock behaviour.
+#ifndef CARDSAT_ENUM_STAGE_RETRIES
+#define CARDSAT_ENUM_STAGE_RETRIES                  3
+#endif
+#ifndef CARDSAT_ENUM_RETRY_DELAY_MS
+#define CARDSAT_ENUM_RETRY_DELAY_MS                 20
+#endif
