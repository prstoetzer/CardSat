+// device supports at least 8, so opening at 8 is legal for any speed and is what the
+// desktop stacks effectively do.
+//
+// Why it may matter here: every device that fails on this hardware reports EP0 max
+// packet 8 (FT232R, the IC-705's internal TUSB2046 hub, the Burr-Brown CODEC), and
+// every device that works reports 64 (Prolific, TH-D75, IC-705 CDC, StarTech hub).
+// Build with -DCARDSAT_ENUM_INITIAL_MPS_FS=8 to test that, and leave it at 64 to
+// restore stock behaviour.
+#ifndef CARDSAT_ENUM_INITIAL_MPS_FS
